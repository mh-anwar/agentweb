l3bwswu80PjjokCgh0o2w5c2U4LhQAE57gj9cz1kzA","sig":"MEUCIQDx21v1V0exampleSignature"}]},"_npmUser":{"name":"jdoe","email":"jane@example.com"},"directories":{},"maintainers":[{"name":"jdoe","email":"jane@example.com"}],"_hasShrinkwrap":false}},"time":{"created":"2013-02-14T21:40:34.512Z","modified":"2026-10-21T09:12:51.002Z","0.1.0":"2013-01-01T10:00:00.000Z","0.2.0":"2013-06-02T10:01:00.000Z","0.3.0":"2014-11-03T10:02:00.000Z","0.4.0":"2014-04-04T10:03:00.000Z","0.4.1":"2015-09-05T10:04:00.000Z","0.5.0":"2015-02-06T10:05:00.000Z","1.0.0":"2016-07-07T10:06:00.000Z","1.0.1":"2016-12-08T10:07:00.000Z","1.1.0":"2017-05-09T10:08:00.000Z","1.2.0":"2017-10-10T10:09:00.000Z","1.3.0":"2018-03-11T10:10:00.000Z","1.3.1":"2018-08-12T10:11:00.000Z","1.4.0":"2019-01-13T10:12:00.000Z","2.0.0":"2019-06-14T10:13:00.000Z","2.0.1":"2020-11-15T10:14:00.000Z","2.1.0":"2020-04-16T10:15:00.000Z","2.2.0":"2021-09-17T10:16:00.000Z","2.2.1":"2021-02-18T10:17:00.000Z","2.3.0":"2022-07-19T10:18:00.000Z","3.0.0-beta.1":"2022-12-20T10:19:00.000Z","3.0.0-beta.2":"2023-05-21T10:20:00.000Z","3.0.0":"2023-10-22T10:21:00.000Z"},"maintainers":[{"name":"jdoe","email":"jane@example.com"},{"name":"rsmith","email":"r.smith@example.org"}],"description":"Fast and minimal glob matcher and directory walker with zero dependencies","homepage":"https://github.com/jdoe/tiny-glob-walker#readme","keywords":["glob","walk","fs","files"],"repository":{"type":"git","url":"git+https://github.com/jdoe/tiny-glob-walker.git"},"author":{"name":"Jane Doe","email":"jane@example.com","url":"https://janedoe.dev"},"bugs":{"url":"https://github.com/jdoe/tiny-glob-walker/issues"},"license":"MIT","readmeFilename":"README.md","readme":"# tiny-glob-walker\n\nFast and minimal glob matcher and directory walker with **zero dependencies**.\n\n## Install\n\n```sh\nnpm install tiny-glob-walker\n```\n\n## Usage\n\n```js\nimport { glob } from 'tiny-glob-walker';\n\nconst files = await glob('src/**/*.ts', { ignore: ['**/*.test.ts'] });\n```\n\n## API\n\n### glob(pattern, options?)\n\nReturns a promise for an array of matching paths.\n\n- `cwd` — directory to search from (default: `process.cwd()`)\n- `ignore` — patterns to skip\n- `dot` — include dotfiles (default: `false`)\n\n### walk(dir, visit)\n\nCalls `visit(path, stat)` for every file below `dir`. Return `false` to skip a directory.\n\n## Benchmarks\n\n| library | ops/sec |\n|---|---|\n| tiny-glob-walker | 41,200 |\n| fast-glob | 33,900 |\n| glob | 12,400 |\n\n## License\n\nMIT © [Jane Doe](https://janedoe.dev)\n","users":{"alice":true,"bob":true,"carol":true,"dave":true,"erin":true,"frank":true,"grace":true,"heidi":true,"ivan":true,"judy":true,"mallory":true,"niaj":true,"olivia":true,"peggy":true,"rupert":true,"sybil":true,"trent":true,"victor":true,"walter":true,"xena":true,"yolanda":true,"zed":true,"amir":true,"bea":true,"chen":true,"dara":true,"eli":true,"fatima":true,"gus":true,"hana":true,"igor":true,"jo":true}}