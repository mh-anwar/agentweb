{
  "name": "agentweb",
  "version": "0.1.0",
  "description": "A browser for agents, not people: one MCP tool, bounded token output, sessions that are data instead of processes.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agentweb": "dist/agentweb.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
