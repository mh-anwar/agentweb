    "test": "node --test test/*.test.ts",
    "bench": "node bench/run.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "gpt-tokenizer": "^4.1.0",
    "htmlparser2": "^12.0.0",
    "typescript": "^7.0.2"
  }
}
